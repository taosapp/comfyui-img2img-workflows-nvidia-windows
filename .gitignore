# 本仓库只跟踪策划资产：工作流 / 风格库 / 自建节点 / 补丁 / 文档。
# 目录本体同时是一套完整 ComfyUI 运行环境（上游代码 + 模型 + 个人素材），
# 一律不进 git，采用白名单模式：

/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/workflows/
!/styles/
!/custom_nodes/
!/patches/
!/scripts/

# 启动器（.bat 是 GBK 编码，靠 .gitattributes 防止换行符被改写）
!/start_comfyui.bat
!/start_comfyui.bat.src.txt
!/start_comfyui.bat.rebuild.py
!/start_comfyui.bat.selftest.py
!/start_comfyui_mac.sh

# custom_nodes 里只保留自建节点包
/custom_nodes/*
!/custom_nodes/comfyui-style-prompt/

# Python
__pycache__/
*.pyc
.venv/

# 系统文件
Thumbs.db
.DS_Store
